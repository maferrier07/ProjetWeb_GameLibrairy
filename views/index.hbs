<h1 class="title">MAIN PAGE</h1>

<div class="slider">
    <button class="prev">&#10094;</button>

    <div class="slider_img">
        {{#each FiveBestRateGame}}
        <a class="slideImgContainer" href="/games/{{this.id}}">
            <img class="slide" src="{{this.image}}" alt="{{this.name}}"/>
            <p class="gameTitle">{{this.name}}</p>
        </a>
        {{/each}}
    </div>

    <button class="next">&#10095;</button>
</div>

<h1 class="title">FAVORITES GAMES</h1>

<br>

<div class="pinCards">
    {{#each PinGame}}
        <a class="pinCard" href="/games/{{this.id}}">
            <a href="google.com"><div class="pin"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" height="40px" width="40px" fill="#000000"><path d="M26.5,20.89L30,24.14v2.78H21.39V36.94L20,38.33l-1.39-1.39V26.92H10V24.14l3.33-3.25V7.78H11.39V5H28.44V7.78H26.5V20.89ZM13.83,24.14H26l-2.28-2.17V7.78H16.11V21.97l-2.28,2.17Zm6.08,0Z"/></svg></div></a>
            <div class="pinGameInfo">
                <img class="gamesPing" src="{{this.image}}" alt="{{this.name}}" width="250" height="250"/>
                <h2 class="pinGameTitle">{{this.name}}</h2>
            </div>
        </a>
    {{/each}}
</div>


<script src="/js/sliderDef.js"></script>