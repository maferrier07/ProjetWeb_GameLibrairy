<h1 class="title">MAIN PAGE</h1>

<div class="slider">
    <button class="prev">&#10094;</button>

    <div class="slider_img">
        {{#each FiveBestRateGame}}
        <a class="slideImgContainer" href="/games/{{this.id}}">
            <img class="slide" src="{{this.image}}" alt="{{this.name}}"/>
            <p class="gameTitle">{{this.name}}</p>
        </a>
        {{/each}}
    </div>

    <button class="next">&#10095;</button>
</div>

<h1 class="title">GAMES</h1>

{{#each FiveBestRateGame}}
        <a class="slideImgContainer" href="/games/{{this.id}}">
            <img class="gamesPing" src="{{this.image}}" alt="{{this.name}}"/>
            <p class="gameTitle">{{this.name}}</p>
        </a>
{{/each}}

<script src="/js/sliderDef.js"></script>